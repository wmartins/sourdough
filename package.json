{
  "name": "sourdough",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "astryx": {
    "theme": "butter"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:pages": "BASE_PATH=/sourdough/ react-router dev",
    "build": "react-router build",
    "build:pages": "BASE_PATH=/sourdough/ react-router build && node scripts/flatten-prerendered-base.mjs sourdough",
    "preview": "vite preview --outDir build/client",
    "preview:pages": "BASE_PATH=/sourdough/ vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:check": "biome format . && prettier --check \"**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:pages && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "biome": "biome",
    "astryx": "astryx",
    "astryx:doctor": "astryx doctor"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.1",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.1",
    "@astryxdesign/theme-butter": "0.5.1",
    "@react-router/node": "7.18.3",
    "@stylexjs/stylex": "0.19.0",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  }
}
