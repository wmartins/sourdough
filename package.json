{
  "name": "sourdough",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "astryx": {
    "theme": "butter"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:pages": "node scripts/with-pages-base.mjs react-router dev",
    "build": "react-router build",
    "build:pages": "node scripts/with-pages-base.mjs react-router build && node scripts/flatten-prerendered-base.mjs sourdough",
    "preview": "vite preview --outDir build/client",
    "preview:pages": "node scripts/with-pages-base.mjs vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "astryx": "astryx",
    "astryx:doctor": "astryx doctor"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.5.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.1",
    "@astryxdesign/theme-butter": "0.5.1",
    "@react-router/node": "7.18.3",
    "@stylexjs/stylex": "0.19.0",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  }
}
